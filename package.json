{
  "name": "smart-base-hphl-rag",
  "version": "1.0.0",
  "description": "Smart-Base (Recuperação de Informação): Catálogo de Conhecimento Corporativo e Helpdesk da Linguagem HP-HL com PostgreSQL 16, Prisma ORM (Trilha A) e RAG Semântico via pgvector (Trilha C)",
  "main": "src/index.js",
  "scripts": {
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "npx prisma migrate dev --name init_smartbase_pgvector",
    "db:generate": "npx prisma generate",
    "seed": "node src/seed.js",
    "search": "node src/search.js",
    "rag": "node src/rag.js",
    "create-ticket": "node src/create-ticket.js",
    "hphl:build": "node src/hphl-bridge.js --build",
    "hphl:benchmark": "node src/hphl-bridge.js --benchmark",
    "demo": "node src/index.js"
  },
  "keywords": [
    "postgresql",
    "prisma",
    "pgvector",
    "rag",
    "helpdesk",
    "hphl",
    "docker"
  ],
  "author": "Dupla — Banco de Dados (Prof. Willen Leolatto Carneiro)",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "pgvector": "^0.2.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
