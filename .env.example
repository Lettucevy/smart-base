# ============================================================================
# Configuração de Ambiente — Smart-Base (HP-HL SmartDiag Helpdesk & RAG)
# ============================================================================

# Credenciais do PostgreSQL 16 (Docker)
POSTGRES_USER=smartbase_user
POSTGRES_PASSWORD=smartbase_pass123
POSTGRES_DB=smartbase_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL de Conexão utilizada pelo Prisma ORM (Trilha A) e cliente pg (Trilha C)
DATABASE_URL="postgresql://smartbase_user:smartbase_pass123@localhost:5432/smartbase_db?schema=public"

# Credenciais do pgAdmin 4 (Docker)
PGADMIN_EMAIL=admin@smartbase.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Configuração da Massa de Dados (Seeder)
SEED_TOTAL_CHAMADOS=5000

# Caminho opcional para o compilador nativo HP-HL (detectado automaticamente se existir)
HPHLC_PATH="C:/Projetos/HPHL/compiler/bin/hphlc.exe"

# Chave opcional da OpenAI (se vazia, usa o Motor Vetorial Híbrido HP-HL de 1536 dimensões)
OPENAI_API_KEY=""
